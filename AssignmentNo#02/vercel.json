{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/items",
      "dest": "/public/items.html"
    },
    {
      "src": "/add",
      "dest": "/public/add.html"
    },
    {
      "src": "/details",
      "dest": "/public/details.html"
    },
    {
      "src": "/about",
      "dest": "/public/about.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
